# 이 파일을 .env 로 복사한 뒤, 값을 자기 환경에 맞게 고쳐서 사용하세요.
#   Windows(cmd):  copy .env.example .env
#   macOS/Linux :  cp .env.example .env
#
# .env 는 .gitignore 에 등록돼 있어 저장소에 올라가지 않습니다.
# 비밀번호 같은 값을 여기(.env.example)에 적지 마세요.

# PostgreSQL 접속 주소
# 형식: postgresql://<사용자>:<비밀번호>@<호스트>:<포트>/<DB이름>
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/banana_db

# YOLO 가중치 경로 (backend/ 기준 상대경로)
MODEL_PATH=weights/best.pt

# 업로드 원본 / 추론 결과 이미지 저장 폴더 (backend/ 기준 상대경로)
UPLOAD_DIR=storage/uploads
RESULT_DIR=storage/results

# 후숙 기간 표 엑셀 파일 경로 (기본값: 저장소 최상위의 banana_riping.xlsx)
# 파일이 없으면 /ripening 기능만 비게 되고, 나머지 기능은 정상 동작합니다.
# RIPING_XLSX_PATH=../banana_riping.xlsx
